# Python virtual environments
venv/
.venv/

# Python cache
__pycache__/
*.pyc

# Trust Service local database
trust-service/trust.db

# Internal CA private key — the CA cert itself (shared/certs/ca.crt) is
# intentionally NOT ignored: /shared/certs/README_2.md is explicit that the
# CA's public cert is safe to commit, only its private key never should be.
shared/certs/ca.key
shared/certs/ca/ca.key

# Node private keys
shared/certs/nodes/*.key
# Local Node Agent certificates
node-agent/certs/*.key
node-agent/certs/*.crt
shared/certs/ca/*.srl

# Generated CA and node certificates
shared/certs/ca/*.crt
shared/certs/nodes/*.crt
shared/certs/nodes/*.csr

# AI Advisor local certificates
advisor/certs/*.key
advisor/certs/*.crt

# Trust Service local certificates
trust-service/*.key
trust-service/*.csr
trust-service/*.crt
trust-service/certs/*.key
trust-service/certs/*.crt

# Global Coordinator local certificates
coordinator/certs/*.key
coordinator/certs/*.csr
coordinator/certs/*.crt
