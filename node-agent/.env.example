# Copy to .env in this folder and fill in real values for your node.
# Variable NAMES for the fields below the blank line must match
# /shared/config/.env.example exactly — see /shared/CONTRACT.md. Don't
# rename them here without updating that file first and telling the team.

NODE_ID=regA-c1-edge1
REGION=regA
CLUSTER=c1

ADVISOR_URL=http://localhost:8100
TRUST_URL=http://localhost:8200
COORDINATOR_URL=http://localhost:9000

CA_CERT_PATH=../shared/certs/ca.crt
CLIENT_CERT_PATH=./certs/node.crt
CLIENT_KEY_PATH=./certs/node.key

# node-agent-local additions below — not part of the cross-service /shared
# contract, safe to rename without touching /shared.

# Address this node advertises to peers when announcing itself via
# POST /register. In a real multi-VM deployment, set to the node's
# Tailscale-reachable URL, e.g. https://100.x.x.x:8000.
SELF_URL=http://localhost:8000
NEIGHBORS_FILE=neighbors.yaml
HOST=0.0.0.0
PORT=8000

# How often the outbound heartbeat loop pings each known neighbor.
HEARTBEAT_INTERVAL_SECONDS=10

# Scheduler (component 5): the one container this node's scheduler watches
# and migrates under sustained overload. Leave empty to keep the scheduler
# inactive (nothing configured to manage).
MANAGED_CONTAINER_NAME=
CPU_OVERLOAD_THRESHOLD=80.0
MEM_OVERLOAD_THRESHOLD=80.0
SUSTAINED_POLLS=3
SCHEDULER_INTERVAL_SECONDS=5
