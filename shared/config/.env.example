# Copy this to .env in each service's folder and fill in the real values.
# Variable NAMES must match exactly across all three services — see CONTRACT.md.

NODE_ID=regA-c1-edge1
REGION=regA
CLUSTER=c1

ADVISOR_URL=https://<advisor-host>:8100
TRUST_URL=https://<trust-service-host>:8200
COORDINATOR_URL=https://<coordinator-host>:9000

CA_CERT_PATH=/shared/certs/ca.crt
CLIENT_CERT_PATH=./certs/node.crt
CLIENT_KEY_PATH=./certs/node.key
