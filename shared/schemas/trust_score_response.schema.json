{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trust_score_response.schema.json",
  "title": "Trust Score Response",
  "description": "Returned by the Trust Service's GET /trust/score/{node_id}.",
  "type": "object",
  "required": ["node_id", "trust_score", "last_updated", "flags"],
  "properties": {
    "node_id": { "type": "string" },
    "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "last_updated": { "type": "string", "format": "date-time" },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "e.g. ['repeated_auth_failure', 'inconsistent_stats']"
    }
  },
  "additionalProperties": false
}
