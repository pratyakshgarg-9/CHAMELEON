{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recommend_request.schema.json",
  "title": "Recommend Request",
  "description": "Sent by Node Agent to the AI Advisor's POST /recommend.",
  "type": "object",
  "required": ["overloaded_node", "candidates"],
  "properties": {
    "overloaded_node": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "stats_payload.schema.json" }
    }
  },
  "additionalProperties": false
}
