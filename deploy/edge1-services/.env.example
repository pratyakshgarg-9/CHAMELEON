# Copy to .env in this directory (docker compose loads it automatically
# for the ${VAR} substitutions in docker-compose.yml — this is separate
# from each service's own certs/.env, if any).
#
# Default (commented out): MTLS_ENABLED=false, each service binds its
# normal port directly (0.0.0.0:8100/8200/9000) — matches today's
# stub-replacement behavior, no nginx involved.
#
# To run with mTLS + CN-check (docker compose --profile mtls up -d --build),
# uncomment below so each service only listens on loopback at an internal
# port, reachable only through its nginx sidecar on the real port:
#
# MTLS_ENABLED=true
# ADVISOR_HOST=127.0.0.1
# ADVISOR_PORT=8101
# TRUST_HOST=127.0.0.1
# TRUST_PORT=8201
# COORDINATOR_HOST=127.0.0.1
# COORDINATOR_PORT=9001

# Dashboard (docker compose up -d dashboard): every node it should watch,
# as node_id=url. Use https:// when the nodes run behind the mtls profile.
# DASHBOARD_NODES=regA-c1-edge1=https://100.115.98.80:8000,regA-c1-edge2=https://100.92.12.44:8000,regA-c1-edge3=https://100.85.175.83:8000
